# =============================================================================
# Aviationsminute Social Media — environment template (local development)
# Copy to .env and fill in real values. Never commit .env.
# =============================================================================

NODE_ENV=development

# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------
API_PORT=5000
API_HOST=0.0.0.0
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info
TRUST_PROXY=1

# -----------------------------------------------------------------------------
# Frontend
# Browser-reachable API origin (no trailing slash, no /api suffix).
# Behind Nginx same-origin in production, set to https://YOUR_DOMAIN
# Leave empty to use same-origin relative /api paths in the browser.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_APP_NAME=Aviationsminute Social Media
# Server-side only (SSR). Prefer localhost Nest when Nginx fronts the public site.
API_INTERNAL_URL=http://127.0.0.1:5000

# -----------------------------------------------------------------------------
# Database (existing Microsoft SQL Server — DigitalSocialMedia)
# Never point this at another database. Never run prisma migrate reset.
# -----------------------------------------------------------------------------
DATABASE_URL=

# -----------------------------------------------------------------------------
# Redis (BullMQ) — keep private; do not expose 6379 publicly
# -----------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379

# -----------------------------------------------------------------------------
# Google OAuth (YouTube)
# Development redirect (Google Cloud must match exactly):
#   http://localhost:5000/api/auth/google/callback
# Production must use HTTPS (see .env.production.example).
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
GOOGLE_AUTH_URI=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_PROJECT_ID=
YOUTUBE_OAUTH_SCOPES=https://www.googleapis.com/auth/youtube.readonly https://www.googleapis.com/auth/yt-analytics.readonly

# -----------------------------------------------------------------------------
# TikTok OAuth (Login Kit) — reserved for upcoming connector
# Scopes: user.info.basic user.info.stats video.list
# Production redirect MUST be HTTPS, e.g.:
#   https://YOUR_DOMAIN/api/auth/tiktok/callback
# Do not submit the TikTok app for review from this template.
# -----------------------------------------------------------------------------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:5000/api/auth/tiktok/callback
TIKTOK_OAUTH_SCOPES=user.info.basic user.info.stats video.list

# -----------------------------------------------------------------------------
# Token encryption and session cookies
# Generate long random values. Never commit real keys.
# SOCIAL_TOKEN_ENCRYPTION_KEY >= 32 characters
# SESSION_SECRET >= 32 characters
# -----------------------------------------------------------------------------
SOCIAL_TOKEN_ENCRYPTION_KEY=
SESSION_SECRET=
WORKSPACE_USER_EMAIL=local-workspace@social-media-analytics.local
