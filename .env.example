# =============================================================================
# Social Media Analytics — environment template
# Copy this file to .env and fill in real values locally.
# Never commit .env or credential JSON files.
# =============================================================================

NODE_ENV=development

# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------
API_PORT=5000
API_HOST=0.0.0.0
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_APP_NAME=Social Media Analytics

# -----------------------------------------------------------------------------
# Database (existing Microsoft SQL Server)
# Source of truth: DigitalSocialMedia, schema social.
# Never point this at another database. Never commit the real .env file.
#
# SQL authentication example:
#   sqlserver://HOST:1433;database=DigitalSocialMedia;user=USER;password=PASSWORD;encrypt=true;trustServerCertificate=true
# Windows authentication example:
#   sqlserver://HOST:PORT;database=DigitalSocialMedia;integratedSecurity=true;encrypt=true;trustServerCertificate=true
# -----------------------------------------------------------------------------
DATABASE_URL=

# -----------------------------------------------------------------------------
# Redis (BullMQ)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Google OAuth (YouTube) — never hardcode these values
# Application type: Web application
# Testing redirect URI currently configured in Google Cloud:
#   http://localhost:5000/api/auth/google/callback
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
GOOGLE_AUTH_URI=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_PROJECT_ID=
YOUTUBE_OAUTH_SCOPES=https://www.googleapis.com/auth/youtube.readonly https://www.googleapis.com/auth/yt-analytics.readonly

# -----------------------------------------------------------------------------
# Token encryption and session cookies
# Generate long random values locally. Never commit real keys.
# SOCIAL_TOKEN_ENCRYPTION_KEY must be at least 32 characters.
# SESSION_SECRET must be at least 32 characters.
# -----------------------------------------------------------------------------
SOCIAL_TOKEN_ENCRYPTION_KEY=
SESSION_SECRET=
WORKSPACE_USER_EMAIL=local-workspace@social-media-analytics.local
