{
  "name": "social-media-analytics",
  "version": "0.1.0",
  "private": true,
  "description": "Production SaaS platform for multi-platform social media analytics.",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "turbo run dev --filter=@sma/web",
    "dev:api": "turbo run dev --filter=@sma/api",
    "dev:worker": "turbo run dev --filter=@sma/worker",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @sma/database generate",
    "db:pull": "pnpm --filter @sma/database pull",
    "db:verify": "pnpm --filter @sma/database verify",
    "db:verify:readonly": "powershell -NoProfile -ExecutionPolicy Bypass -File packages/database/scripts/verify-readonly.ps1",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "msgpackr-extract",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  }
}
