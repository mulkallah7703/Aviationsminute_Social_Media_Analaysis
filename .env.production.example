# =============================================================================
# Aviationsminute Social Media — PRODUCTION environment template
# Copy values into the VPS .env (never commit real secrets).
# Replace YOUR_DOMAIN and other placeholders before starting services.
# =============================================================================

NODE_ENV=production

# -----------------------------------------------------------------------------
# API (bind localhost; Nginx is the only public entry)
# -----------------------------------------------------------------------------
API_PORT=5000
API_HOST=127.0.0.1
WEB_ORIGIN=https://YOUR_DOMAIN
LOG_LEVEL=info
TRUST_PROXY=1

# -----------------------------------------------------------------------------
# Frontend (bake NEXT_PUBLIC_* at build time)
# NEXT_PUBLIC_API_URL must be the public origin WITHOUT /api suffix.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://YOUR_DOMAIN
NEXT_PUBLIC_APP_NAME=Aviationsminute Social Media
API_INTERNAL_URL=http://127.0.0.1:5000

# -----------------------------------------------------------------------------
# Database — existing SQL Server DigitalSocialMedia (external)
# Example shape only — use your real credentials on the VPS:
#   sqlserver://HOST:1433;database=DigitalSocialMedia;user=USER;password=PASSWORD;encrypt=true;trustServerCertificate=true
# -----------------------------------------------------------------------------
DATABASE_URL=YOUR_DATABASE_URL

# -----------------------------------------------------------------------------
# Redis — localhost + password (see docker-compose.prod.yml)
# -----------------------------------------------------------------------------
REDIS_URL=redis://:YOUR_REDIS_PASSWORD@127.0.0.1:6379
REDIS_PASSWORD=YOUR_REDIS_PASSWORD

# -----------------------------------------------------------------------------
# Google OAuth (YouTube) — HTTPS callback required
# Register in Google Cloud Console exactly:
#   https://YOUR_DOMAIN/api/auth/google/callback
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=https://YOUR_DOMAIN/api/auth/google/callback
GOOGLE_AUTH_URI=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_PROJECT_ID=YOUR_GOOGLE_PROJECT_ID
YOUTUBE_OAUTH_SCOPES=https://www.googleapis.com/auth/youtube.readonly https://www.googleapis.com/auth/yt-analytics.readonly

# -----------------------------------------------------------------------------
# TikTok Login Kit — HTTPS callback required
# Register exactly:
#   https://aviationsminuteanalysis.com/api/auth/tiktok/callback
# Scopes:
#   user.info.basic user.info.stats video.list
# See TIKTOK.md
# -----------------------------------------------------------------------------
TIKTOK_CLIENT_KEY=YOUR_TIKTOK_CLIENT_KEY
TIKTOK_CLIENT_SECRET=YOUR_TIKTOK_CLIENT_SECRET
TIKTOK_REDIRECT_URI=https://aviationsminuteanalysis.com/api/auth/tiktok/callback
TIKTOK_OAUTH_SCOPES=user.info.basic user.info.stats video.list

# -----------------------------------------------------------------------------
# Secrets (>= 32 characters each). Generate with:
#   openssl rand -hex 32
# -----------------------------------------------------------------------------
SOCIAL_TOKEN_ENCRYPTION_KEY=YOUR_SOCIAL_TOKEN_ENCRYPTION_KEY
SESSION_SECRET=YOUR_SESSION_SECRET
WORKSPACE_USER_EMAIL=YOUR_WORKSPACE_USER_EMAIL
